<!-- 文件用途：原生白色贴边浮栏、真实文件结果及文件夹定位；列表保持虚拟化。 -->
<Window x:Class="FlashFind.Desktop.Views.QuickSearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="文件搜索 · 便捷搜索" Icon="/文件搜索;component/Assets/FileSearch.ico"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 ShowActivated="False" Topmost="True" Width="416" Height="460" FontFamily="{StaticResource InterfaceFont}" FontSize="13"
 Foreground="{StaticResource Ink}" UseLayoutRounding="False" SnapsToDevicePixels="True" PreviewKeyDown="QuickKeyDown">
 <Window.Resources>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8" /><Setter Property="Background" Value="Transparent" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Background="{StaticResource Line}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1,2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Width" Value="28" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="0" />
   <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="15" />
   <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style x:Key="QuickItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Height" Value="62" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="Transparent" CornerRadius="8"><ContentPresenter /></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" /></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="RenderRoot" Background="Transparent">
  <Border x:Name="Surface" Background="White" Height="64" VerticalAlignment="Top" CornerRadius="16,0,0,16">
   <Grid x:Name="SurfaceContents">
    <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="64" /><RowDefinition x:Name="SecondRow" Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="SearchBar" Height="64" Margin="12,0,26,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Button x:Name="DragHandle" Style="{StaticResource QuickButton}" Cursor="SizeAll" Content="&#xE784;" ToolTip="拖动浮条，松开后吸附四边" AutomationProperties.Name="拖动悬浮搜索" />
     <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,4,0" />
     <Grid Grid.Column="2" Margin="7,8,4,8">
      <TextBlock x:Name="QuickPlaceholder" Text="搜索文件名…" Foreground="{StaticResource Muted}" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
         <Condition Binding="{Binding Text, ElementName=QuickInput}" Value="" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickInput}" Value="False" />
        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBox x:Name="QuickInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" FontSize="15" BorderThickness="0" Padding="0"
       Background="Transparent" VerticalContentAlignment="Center" AutomationProperties.Name="便捷搜索文件名" />
     </Grid>
     <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="QuickClear" Command="{Binding ClearCommand}" Content="&#xE711;" ToolTip="清空搜索" AutomationProperties.Name="清空便捷搜索">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickButton}"><Style.Triggers>
        <DataTrigger Binding="{Binding Text, ElementName=QuickInput}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
      <Button Style="{StaticResource QuickButton}" Content="&#xE740;" Click="RestoreClick" ToolTip="打开主窗口" AutomationProperties.Name="恢复文件搜索主窗口" />
      <Button x:Name="CollapseButton" Style="{StaticResource QuickButton}" Click="CollapseClick" ToolTip="收起 · Esc" AutomationProperties.Name="收起便捷搜索">
       <Path x:Name="CollapseArrow" Data="M 1,1 L 6,6 L 1,11" Stroke="{StaticResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
      </Button>
     </StackPanel>
    </Grid>
    <Grid x:Name="Details" Grid.Row="1" Margin="12,0" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource FilterTab}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" AutomationProperties.Name="便捷搜索文件类型">
       <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Column="1" Text="{Binding Results.Count, StringFormat={}{0:N0} 个结果}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
     </Grid>
     <Grid Grid.Row="1">
      <ListBox x:Name="QuickResults" SelectedItem="{Binding Selected}" BorderThickness="0" Padding="0" Background="Transparent" ItemContainerStyle="{StaticResource QuickItem}" MouseDoubleClick="ResultDoubleClick"
       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="便捷搜索全部结果">
       <!-- 去掉系统列表模板额外的两像素内边距，保证计算出的可见行完整容纳。 -->
       <ListBox.Template><ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
         <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
          <ItemsPresenter />
         </ScrollViewer>
        </Border>
       </ControlTemplate></ListBox.Template>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Margin="6,8" ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
         <Path Data="M 4,1 L 13,1 L 19,7 L 19,23 L 4,23 Z M 13,1 L 13,7 L 19,7" Width="16" Height="21" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Left" />
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
         <Button Grid.Column="2" Style="{StaticResource QuickButton}" Focusable="False" IsTabStop="False" Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="打开文件夹并选中文件" AutomationProperties.Name="便捷搜索定位文件">
          <Path Data="M 2,5 L 9,5 L 11,8 L 22,8 L 22,21 L 2,21 Z" Width="17" Height="15" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3" />
         </Button>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
       <TextBlock Text="{Binding EmptyTitle}" FontWeight="Medium" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyDetail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="280" />
      </StackPanel>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Scope, StringFormat=本机硬盘 · {0}}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="↑↓ 选择 · Enter 定位" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
     </Grid>
    </Grid>
   </Grid>
  </Border>
  <Canvas x:Name="PeekCanvas">
   <Grid x:Name="PeekHandle" Width="22" Height="64" Background="Transparent" Cursor="SizeAll" ToolTip="悬停搜索 · 拖动换边" AutomationProperties.Name="悬浮文件搜索入口">
    <TextBlock x:Name="PeekSearch" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    <TextBlock x:Name="PeekGrip" Text="&#xE784;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Opacity="0" />
   </Grid>
  </Canvas>
  <Border x:Name="DragGhost" Width="40" Height="64" Background="White" CornerRadius="12" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
   <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
  </Border>
 </Grid>
</Window>
